rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SECURITY HELPERS
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Safe token claim existence helpers (prevents CEL undefined-property
    // errors for Firebase Anonymous Auth, email-only, or phone-only tokens).
    function hasTokenKey(key) {
      return isSignedIn() && request.auth.token != null && (key in request.auth.token);
    }

    function hasPhoneToken() {
      return hasTokenKey('phone_number') &&
        request.auth.token.phone_number is string &&
        request.auth.token.phone_number.size() > 0;
    }

    // Exact Firebase Auth token phone_number comparison against document phone
    function hasMatchingVerifiedPhone(phoneVal) {
      return hasPhoneToken() &&
        phoneVal is string &&
        phoneVal == request.auth.token.phone_number;
    }

    function hasVerifiedEmailToken() {
      return request.auth != null &&
        request.auth.token != null &&
        ('email_verified' in request.auth.token) &&
        request.auth.token.email_verified == true &&
        ('email' in request.auth.token) &&
        request.auth.token.email is string;
    }

    // Verified Super Admin: requires cryptographic Firebase Auth token with
    // verified email matching the authorized platform owner.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token != null &&
        ('email_verified' in request.auth.token) &&
        request.auth.token.email_verified == true &&
        ('email' in request.auth.token) &&
        request.auth.token.email == 'taibaralir@gmail.com';
    }

    // Role Account lookup: Admin-provisioned /partnerAccounts/{uid}
    function hasPartnerAccount() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid));
    }

    function checkPartnerRoleDoc(paData, allowedRoles) {
      return paData.status == 'active' && paData.role in allowedRoles;
    }

    function hasPartnerRole(allowedRoles) {
      return hasPartnerAccount() &&
        checkPartnerRoleDoc(get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data, allowedRoles);
    }

    function checkPartnerEntityMatch(paData, allowedRoles, entityId) {
      return paData.status == 'active' &&
        paData.role in allowedRoles &&
        paData.linkedEntityId == entityId;
    }

    function hasPartnerAccountForEntity(allowedRoles, entityId) {
      return request.auth != null &&
        isValidId(entityId) &&
        exists(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)) &&
        ('linkedEntityId' in get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data) &&
        checkPartnerEntityMatch(
          get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data,
          allowedRoles,
          entityId
        );
    }

    function checkOwnerPartnerDoc(paData, expectedRole, entityId) {
      return paData.status == 'active' &&
        paData.role == expectedRole &&
        ('linkedEntityId' in paData) &&
        paData.linkedEntityId == entityId;
    }

    // Active partner account verification for an arbitrary entity owner (never falls back to empty ownerId)
    function isActivePartnerOwnerAccount(ownerId, expectedRole, entityId) {
      return ownerId is string &&
        ownerId.size() > 0 &&
        ownerId.size() <= 128 &&
        exists(/databases/$(database)/documents/partnerAccounts/$(ownerId)) &&
        checkOwnerPartnerDoc(
          get(/databases/$(database)/documents/partnerAccounts/$(ownerId)).data,
          expectedRole,
          entityId
        );
    }

    function checkEmployerDoc(paData) {
      let pa = paData;
      return pa.status == 'active' && pa.role == 'employer';
    }

    function isActiveEmployerAccount(ownerId) {
      return isValidId(ownerId) &&
        exists(/databases/$(database)/documents/partnerAccounts/$(ownerId)) &&
        checkEmployerDoc(get(/databases/$(database)/documents/partnerAccounts/$(ownerId)).data);
    }

    // Relational shop approval check (server-side doc check via get/exists)
    function isShopApproved(shopId) {
      return isValidId(shopId) &&
        exists(/databases/$(database)/documents/shops/$(shopId)) &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.status == 'approved';
    }

    function checkApprovedOwnedEntity(entityData) {
      return entityData.status == 'approved' && entityData.ownerId == request.auth.uid;
    }

    // Relational shop ownership check (must be an active shopkeeper account & approved shop owned by caller)
    function isApprovedShopOwner(shopId) {
      return request.auth != null &&
        hasPartnerAccountForEntity(['shopkeeper'], shopId) &&
        exists(/databases/$(database)/documents/shops/$(shopId)) &&
        checkApprovedOwnedEntity(get(/databases/$(database)/documents/shops/$(shopId)).data);
    }

    // Relational doctor ownership check (must be an active doctor account & approved doctor owned by caller)
    function isApprovedDoctorOwner(doctorDocId) {
      return request.auth != null &&
        hasPartnerAccountForEntity(['doctor'], doctorDocId) &&
        exists(/databases/$(database)/documents/doctors/$(doctorDocId)) &&
        checkApprovedOwnedEntity(get(/databases/$(database)/documents/doctors/$(doctorDocId)).data);
    }

    // Relational driver approval & ownership checks
    function isApprovedDriverRecord(driverDocId) {
      return isValidId(driverDocId) &&
        exists(/databases/$(database)/documents/drivers/$(driverDocId)) &&
        get(/databases/$(database)/documents/drivers/$(driverDocId)).data.status == 'approved';
    }

    function isApprovedDriverOwner(driverDocId) {
      return request.auth != null &&
        hasPartnerAccountForEntity(['driver'], driverDocId) &&
        exists(/databases/$(database)/documents/drivers/$(driverDocId)) &&
        checkApprovedOwnedEntity(get(/databases/$(database)/documents/drivers/$(driverDocId)).data);
    }

    function callerDriverId() {
      return get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.linkedEntityId;
    }

    function isApprovedDriverDocOwned(drvId) {
      return drvId is string &&
        drvId.size() > 0 &&
        exists(/databases/$(database)/documents/drivers/$(drvId)) &&
        checkApprovedOwnedEntity(get(/databases/$(database)/documents/drivers/$(drvId)).data);
    }

    function checkActiveDriverPartner(pa) {
      return pa.status == 'active' &&
        pa.role == 'driver' &&
        ('linkedEntityId' in pa) &&
        isApprovedDriverDocOwned(pa.linkedEntityId);
    }

    function isActiveApprovedDriver() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)) &&
        checkActiveDriverPartner(get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data);
    }

    function callerDriverVehicleType() {
      return get(/databases/$(database)/documents/drivers/$(callerDriverId())).data.vehicleType;
    }

    // Relational delivery rider approval & ownership checks
    function isApprovedRiderRecord(personDocId) {
      return isValidId(personDocId) &&
        exists(/databases/$(database)/documents/deliveryPersons/$(personDocId)) &&
        get(/databases/$(database)/documents/deliveryPersons/$(personDocId)).data.status == 'approved';
    }

    function isApprovedDeliveryOwner(personDocId) {
      return request.auth != null &&
        hasPartnerAccountForEntity(['delivery'], personDocId) &&
        exists(/databases/$(database)/documents/deliveryPersons/$(personDocId)) &&
        checkApprovedOwnedEntity(get(/databases/$(database)/documents/deliveryPersons/$(personDocId)).data);
    }

    // Relational service provider ownership check (providerId stores /serviceProviders/{providerId} doc ID)
    function isApprovedServiceProviderOwner(providerDocId) {
      return request.auth != null &&
        hasPartnerAccountForEntity(['service_provider'], providerDocId) &&
        exists(/databases/$(database)/documents/serviceProviders/$(providerDocId)) &&
        checkApprovedOwnedEntity(get(/databases/$(database)/documents/serviceProviders/$(providerDocId)).data);
    }

    // Relational job ownership check (must be an active employer account)
    function isJobOwner(jobId) {
      return isSignedIn() &&
        hasPartnerRole(['employer']) &&
        jobId is string &&
        isValidId(jobId) &&
        exists(/databases/$(database)/documents/jobs/$(jobId)) &&
        get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid;
    }

    // Post-commit consistency checks for admin public projection writes (writeBatch safe)
    function isAfterShopApprovedWithActiveOwner(shopId, expectedStatus) {
      return existsAfter(/databases/$(database)/documents/shops/$(shopId)) &&
        getAfter(/databases/$(database)/documents/shops/$(shopId)).data.status == expectedStatus &&
        (
          expectedStatus != 'approved' ||
          (
            ('ownerId' in getAfter(/databases/$(database)/documents/shops/$(shopId)).data) &&
            isValidId(getAfter(/databases/$(database)/documents/shops/$(shopId)).data.ownerId) &&
            existsAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/shops/$(shopId)).data.ownerId)) &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/shops/$(shopId)).data.ownerId)).data.status == 'active' &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/shops/$(shopId)).data.ownerId)).data.role == 'shopkeeper' &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/shops/$(shopId)).data.ownerId)).data.linkedEntityId == shopId
          )
        );
    }

    function isAfterRiderApprovedWithActiveOwner(riderId, expectedStatus) {
      return existsAfter(/databases/$(database)/documents/deliveryPersons/$(riderId)) &&
        getAfter(/databases/$(database)/documents/deliveryPersons/$(riderId)).data.status == expectedStatus &&
        (
          expectedStatus != 'approved' ||
          (
            ('ownerId' in getAfter(/databases/$(database)/documents/deliveryPersons/$(riderId)).data) &&
            isValidId(getAfter(/databases/$(database)/documents/deliveryPersons/$(riderId)).data.ownerId) &&
            existsAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/deliveryPersons/$(riderId)).data.ownerId)) &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/deliveryPersons/$(riderId)).data.ownerId)).data.status == 'active' &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/deliveryPersons/$(riderId)).data.ownerId)).data.role == 'delivery' &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/deliveryPersons/$(riderId)).data.ownerId)).data.linkedEntityId == riderId
          )
        );
    }

    function isAfterDriverApprovedWithActiveOwner(driverId, expectedStatus) {
      return existsAfter(/databases/$(database)/documents/drivers/$(driverId)) &&
        getAfter(/databases/$(database)/documents/drivers/$(driverId)).data.status == expectedStatus &&
        (
          expectedStatus != 'approved' ||
          (
            ('ownerId' in getAfter(/databases/$(database)/documents/drivers/$(driverId)).data) &&
            isValidId(getAfter(/databases/$(database)/documents/drivers/$(driverId)).data.ownerId) &&
            existsAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/drivers/$(driverId)).data.ownerId)) &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/drivers/$(driverId)).data.ownerId)).data.status == 'active' &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/drivers/$(driverId)).data.ownerId)).data.role == 'driver' &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/drivers/$(driverId)).data.ownerId)).data.linkedEntityId == driverId
          )
        );
    }

    function isAfterDoctorApprovedWithActiveOwner(doctorId, expectedStatus) {
      return existsAfter(/databases/$(database)/documents/doctors/$(doctorId)) &&
        getAfter(/databases/$(database)/documents/doctors/$(doctorId)).data.status == expectedStatus &&
        (
          expectedStatus != 'approved' ||
          (
            ('ownerId' in getAfter(/databases/$(database)/documents/doctors/$(doctorId)).data) &&
            isValidId(getAfter(/databases/$(database)/documents/doctors/$(doctorId)).data.ownerId) &&
            existsAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/doctors/$(doctorId)).data.ownerId)) &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/doctors/$(doctorId)).data.ownerId)).data.status == 'active' &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/doctors/$(doctorId)).data.ownerId)).data.role == 'doctor' &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/doctors/$(doctorId)).data.ownerId)).data.linkedEntityId == doctorId
          )
        );
    }

    function isAfterProviderApprovedWithActiveOwner(providerId, expectedStatus) {
      return existsAfter(/databases/$(database)/documents/serviceProviders/$(providerId)) &&
        getAfter(/databases/$(database)/documents/serviceProviders/$(providerId)).data.status == expectedStatus &&
        (
          expectedStatus != 'approved' ||
          (
            ('ownerId' in getAfter(/databases/$(database)/documents/serviceProviders/$(providerId)).data) &&
            isValidId(getAfter(/databases/$(database)/documents/serviceProviders/$(providerId)).data.ownerId) &&
            existsAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/serviceProviders/$(providerId)).data.ownerId)) &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/serviceProviders/$(providerId)).data.ownerId)).data.status == 'active' &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/serviceProviders/$(providerId)).data.ownerId)).data.role == 'service_provider' &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/serviceProviders/$(providerId)).data.ownerId)).data.linkedEntityId == providerId
          )
        );
    }

    function isAfterJobApprovedWithActiveOwner(jobId, expectedStatus) {
      return existsAfter(/databases/$(database)/documents/jobs/$(jobId)) &&
        getAfter(/databases/$(database)/documents/jobs/$(jobId)).data.status == expectedStatus &&
        (
          expectedStatus != 'approved' ||
          (
            ('employerId' in getAfter(/databases/$(database)/documents/jobs/$(jobId)).data) &&
            isValidId(getAfter(/databases/$(database)/documents/jobs/$(jobId)).data.employerId) &&
            existsAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/jobs/$(jobId)).data.employerId)) &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/jobs/$(jobId)).data.employerId)).data.status == 'active' &&
            getAfter(/databases/$(database)/documents/partnerAccounts/$(getAfter(/databases/$(database)/documents/jobs/$(jobId)).data.employerId)).data.role == 'employer'
          )
        );
    }

    // Strict rider eligibility check for shopkeeper dispatch on /orders
    function checkLocalityRuleForRider(riderId, riderData, loc, rule) {
      return rule.crossLocalityEnabled == true &&
        (
          riderId in rule.deliveryRiderIds ||
          ('servedLocalities' in riderData && loc in riderData.servedLocalities) ||
          riderData.locality in rule.nearbyLocalities
        );
    }

    function isCrossLocalityRiderAllowed(riderId, riderData, loc) {
      let cfg = get(/databases/$(database)/documents/routingConfig/universal).data;
      return exists(/databases/$(database)/documents/routingConfig/universal) &&
        cfg.globalCrossLocalityEnabled == true &&
        (loc in cfg.rulesByLocality) &&
        checkLocalityRuleForRider(riderId, riderData, loc, cfg.rulesByLocality[loc]);
    }

    function checkRiderDocEligibility(riderId, rider, loc) {
      return rider.status == 'approved' &&
        rider.isOnline == true &&
        ('ownerId' in rider) &&
        isActivePartnerOwnerAccount(rider.ownerId, 'delivery', riderId) &&
        (
          (
            rider.locality == loc &&
            (!('currentLocation' in rider) || rider.currentLocation == '' || rider.currentLocation == loc)
          ) ||
          isCrossLocalityRiderAllowed(riderId, rider, loc)
        );
    }

    function isEligibleOnlineDeliveryRiderForShop(riderId, shopLocality) {
      return riderId is string &&
        isValidId(riderId) &&
        exists(/databases/$(database)/documents/deliveryPersons/$(riderId)) &&
        checkRiderDocEligibility(
          riderId,
          get(/databases/$(database)/documents/deliveryPersons/$(riderId)).data,
          shopLocality
        );
    }

    // =========================================================================
    // ENTITY & STRICT ALLOWLIST VALIDATION HELPERS
    // =========================================================================
    function isValidCustomerData(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
        (!('pincode' in data) || (data.pincode is string && data.pincode.size() <= 16)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
        (!('state' in data) || (data.state is string && data.state.size() <= 80)) &&
        (!('district' in data) || (data.district is string && data.district.size() <= 80)) &&
        (!('block' in data) || (data.block is string && data.block.size() <= 80)) &&
        !('role' in data) &&
        !('partnerRole' in data) &&
        !('approved' in data) &&
        !('status' in data) &&
        !('isAdmin' in data) &&
        !('admin' in data) &&
        !('password' in data) &&
        (!('isPhoneVerified' in data) || data.isPhoneVerified == hasMatchingVerifiedPhone(data.phone)) &&
        (!('isVerified' in data) || data.isVerified == (hasMatchingVerifiedPhone(data.phone) || hasVerifiedEmailToken())) &&
        (!('authMethod' in data) || (
          data.authMethod in ['anonymous', 'google', 'email', 'phone', 'none'] &&
          (data.authMethod != 'phone' || hasMatchingVerifiedPhone(data.phone))
        ));
    }

    function isValidShopData(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.locality is string && data.locality.size() > 0 && data.locality.size() <= 100 &&
        data.contactNumber is string && data.contactNumber.size() > 0 && data.contactNumber.size() <= 30 &&
        data.status in ['pending', 'approved', 'rejected', 'suspended'] &&
        (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1500));
    }

    function isValidPartnerAccountData(data) {
      return data.keys().hasAll(['uid', 'role', 'displayName', 'loginEmail', 'status', 'assignedBy']) &&
        data.keys().hasOnly([
          'uid', 'role', 'displayName', 'loginEmail', 'phone',
          'linkedEntityId', 'status', 'suspendedEntityPreviousStatus',
          'assignedBy', 'createdAt', 'updatedAt'
        ]) &&
        !('password' in data) &&
        !('isAdmin' in data) &&
        !('admin' in data) &&
        data.uid is string && isValidId(data.uid) &&
        data.role in ['shopkeeper', 'driver', 'delivery', 'doctor', 'service_provider', 'employer', 'kabari'] &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 150 &&
        data.loginEmail is string && data.loginEmail.size() > 0 && data.loginEmail.size() <= 150 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30)) &&
        (!('linkedEntityId' in data) || isValidId(data.linkedEntityId)) &&
        (!('suspendedEntityPreviousStatus' in data) || data.suspendedEntityPreviousStatus in ['pending', 'approved', 'rejected', 'suspended']) &&
        data.status in ['active', 'suspended'] &&
        data.assignedBy is string && data.assignedBy.size() > 0 && data.assignedBy.size() <= 150;
    }

    function isValidPhoneAuthLookupData(data) {
      return data.keys().hasAll(['loginEmail']) &&
        data.keys().hasOnly(['loginEmail', 'updatedAt']) &&
        data.loginEmail is string && data.loginEmail.size() > 0 && data.loginEmail.size() <= 150;
    }

    // Strict allowlist for publicShops (no ownerId, ownerEmail, private phone, license, revenue)
    function isValidPublicShopCard(data) {
      return data.keys().hasAll(['id', 'name', 'locality', 'category', 'status']) &&
        data.keys().hasOnly([
          'id', 'name', 'locality', 'pincode', 'imageUrl', 'description',
          'category', 'shopType', 'status', 'isVerified', 'isOpen',
          'deliveryAreas', 'deliveryCharge', 'freeDeliveryAbove',
          'deliveryRadiusKm', 'rating', 'businessHours',
          'publishContact', 'publicContactNumber', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.locality is string && data.locality.size() > 0 && data.locality.size() <= 100 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
        data.status in ['pending', 'approved', 'rejected', 'suspended'] &&
        (!('pincode' in data) || (data.pincode is string && data.pincode.size() <= 16)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1500)) &&
        (!('businessHours' in data) || (data.businessHours is string && data.businessHours.size() <= 120)) &&
        (
          !('publicContactNumber' in data) ||
          (('publishContact' in data) && data.publishContact == true && data.publicContactNumber is string && data.publicContactNumber.size() > 0 && data.publicContactNumber.size() <= 30)
        );
    }

    // Strict allowlist for publicDoctors (no ownerId, phone, email, clinicAddress, regNo, documentUrl)
    function isValidPublicDoctorCard(data) {
      return data.keys().hasAll(['id', 'name', 'qualification', 'specialization', 'consultationFee', 'status']) &&
        data.keys().hasOnly([
          'id', 'name', 'qualification', 'specialization', 'experienceYears',
          'consultationFee', 'homeVisitFee', 'localitiesServed', 'servedLocalities',
          'parentArea', 'availableSchedule', 'isOnline', 'isAvailable',
          'status', 'rating', 'completedConsultations', 'totalConsultations', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.qualification is string && data.qualification.size() > 0 && data.qualification.size() <= 120 &&
        data.specialization is string && data.specialization.size() > 0 && data.specialization.size() <= 120 &&
        data.consultationFee is number && data.consultationFee >= 0 &&
        data.status in ['pending', 'approved', 'rejected', 'suspended'];
    }

    // Strict allowlist for publicServiceProviders (no ownerId, phone, email, licenseNumber, documentUrl)
    function isValidPublicServiceProviderCard(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'serviceArea', 'hourlyRate', 'status']) &&
        data.keys().hasOnly([
          'id', 'name', 'category', 'serviceArea', 'description',
          'experienceYears', 'hourlyRate', 'status', 'isAvailable',
          'rating', 'totalJobsCompleted', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
        data.serviceArea is string && data.serviceArea.size() > 0 && data.serviceArea.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1500)) &&
        data.hourlyRate is number && data.hourlyRate >= 0 &&
        data.status in ['pending', 'approved', 'rejected', 'suspended'];
    }

    // Strict allowlist for publicJobs (no employerId, employerName, private employerPhone; explicit publicContact policy)
    function isValidPublicJobCard(data) {
      return data.keys().hasAll(['id', 'title', 'company', 'category', 'location', 'salary', 'jobType', 'status']) &&
        data.keys().hasOnly([
          'id', 'title', 'company', 'category', 'location', 'salary',
          'jobType', 'description', 'vacancies', 'applicantsCount', 'status',
          'posted', 'publishContact', 'publicContactNumber', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.company is string && data.company.size() > 0 && data.company.size() <= 150 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 80 &&
        data.location is string && data.location.size() > 0 && data.location.size() <= 150 &&
        data.salary is string && data.salary.size() > 0 && data.salary.size() <= 80 &&
        data.jobType in ['Full-time', 'Part-time', 'Urgent', 'Flexible'] &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (
          !('publicContactNumber' in data) ||
          (('publishContact' in data) && data.publishContact == true && data.publicContactNumber is string && data.publicContactNumber.size() > 0 && data.publicContactNumber.size() <= 30)
        );
    }

    // Strict allowlist for publicRiders (no ownerId, phone, email)
    function isValidPublicRiderCard(data) {
      return data.keys().hasAll(['id', 'name', 'locality', 'status']) &&
        data.keys().hasOnly([
          'id', 'name', 'locality', 'currentLocation', 'servedLocalities',
          'status', 'isOnline', 'accountStatus', 'rating', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.locality is string && data.locality.size() > 0 && data.locality.size() <= 120 &&
        (!('currentLocation' in data) || (data.currentLocation is string && data.currentLocation.size() <= 120)) &&
        (!('servedLocalities' in data) || data.servedLocalities is list) &&
        (!('accountStatus' in data) || data.accountStatus in ['active', 'suspended']) &&
        data.status in ['pending', 'approved', 'rejected', 'suspended'];
    }

    // Strict allowlist for publicDrivers (no ownerId, phone, email, vehicleNumber, licenseNumber)
    function isValidPublicDriverCard(data) {
      return data.keys().hasAll(['id', 'name', 'vehicleType', 'locality', 'status']) &&
        data.keys().hasOnly([
          'id', 'name', 'vehicleType', 'locality', 'currentLocation', 'servedLocalities',
          'status', 'isOnline', 'accountStatus', 'rating', 'totalRides', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.vehicleType in ['toto', 'auto', 'taxi'] &&
        data.locality is string && data.locality.size() > 0 && data.locality.size() <= 120 &&
        (!('currentLocation' in data) || (data.currentLocation is string && data.currentLocation.size() <= 120)) &&
        (!('servedLocalities' in data) || data.servedLocalities is list) &&
        (!('accountStatus' in data) || data.accountStatus in ['active', 'suspended']) &&
        data.status in ['pending', 'approved', 'rejected', 'suspended'];
    }

    function isValidProductData(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 80 &&
        data.shopId is string && isValidId(data.shopId) &&
        data.shopStatus in ['pending', 'approved', 'rejected', 'suspended'] &&
        data.price is number && data.price >= 0 &&
        data.unit is string && data.unit.size() > 0 && data.unit.size() <= 40 &&
        data.inStock is bool &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    // Strict allowlist for publicProducts (forbids ownerId)
    function isValidPublicProductCard(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'shopId', 'shopStatus', 'price', 'unit', 'inStock']) &&
        data.keys().hasOnly([
          'id', 'shopId', 'shopName', 'shopStatus', 'name', 'localName',
          'price', 'originalPrice', 'unit', 'image', 'category', 'categoryType',
          'rating', 'inStock', 'stock', 'isAvailable', 'isDeal', 'badge',
          'description', 'brand', 'isBrandNew', 'specs', 'warranty',
          'sellerName', 'sellerLocality', 'requiresPrescription', 'expiryDate',
          'dosageForm', 'manufacturer', 'isWeightBased', 'pricePerKg',
          'availableWeights', 'dailyFresh', 'createdAt', 'updatedAt'
        ]) &&
        !('ownerId' in data) &&
        data.id is string && isValidId(data.id) &&
        isValidProductData(data);
    }

    function isValidOrderData(data) {
      return data.customerId is string && data.customerId.size() > 0 && data.customerId.size() <= 128 &&
        data.shopId is string && isValidId(data.shopId) &&
        (!('shopOwnerId' in data) || (data.shopOwnerId is string && data.shopOwnerId.size() <= 128)) &&
        data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 30 &&
        data.deliveryAddress is string && data.deliveryAddress.size() > 0 && data.deliveryAddress.size() <= 500 &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.deliveryFee is number && data.deliveryFee >= 0 &&
        data.discount is number && data.discount >= 0 &&
        data.total is number && data.total >= 0 &&
        (
          data.total == data.subtotal + data.deliveryFee - data.discount ||
          (data.subtotal + data.deliveryFee - data.discount < 0 && data.total == 0)
        ) &&
        data.paymentMethod is string && data.paymentMethod.size() > 0 && data.paymentMethod.size() <= 60 &&
        data.status in [
          'pending', 'placed', 'confirmed', 'preparing', 'ready_for_dispatch',
          'packed', 'out_for_delivery', 'delivered', 'cancelled', 'rejected'
        ] &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 100;
    }

    function isValidServiceRequestData(data) {
      return data.customerId is string && data.customerId.size() > 0 && data.customerId.size() <= 128 &&
        data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 30 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 80 &&
        data.address is string && data.address.size() > 0 && data.address.size() <= 500 &&
        data.preferredDate is string && data.preferredDate.size() > 0 && data.preferredDate.size() <= 60 &&
        data.preferredTime is string && data.preferredTime.size() > 0 && data.preferredTime.size() <= 80 &&
        data.issueDescription is string && data.issueDescription.size() > 0 && data.issueDescription.size() <= 1000 &&
        data.estimatedFee is number && data.estimatedFee >= 0 &&
        (!('finalFee' in data) || (data.finalFee is number && data.finalFee >= 0)) &&
        (!('providerId' in data) || isValidId(data.providerId)) &&
        (!('providerOwnerId' in data) || (data.providerOwnerId is string && data.providerOwnerId.size() <= 128)) &&
        data.status in ['requested', 'accepted', 'in_progress', 'completed', 'cancelled'];
    }

    function isValidJobData(data) {
      return data.employerId is string && data.employerId.size() > 0 && data.employerId.size() <= 128 &&
        data.employerName is string && data.employerName.size() > 0 && data.employerName.size() <= 120 &&
        data.employerPhone is string && data.employerPhone.size() > 0 && data.employerPhone.size() <= 30 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 80 &&
        data.location is string && data.location.size() > 0 && data.location.size() <= 150 &&
        data.salary is string && data.salary.size() > 0 && data.salary.size() <= 80 &&
        data.jobType in ['Full-time', 'Part-time', 'Urgent', 'Flexible'] &&
        data.description is string && data.description.size() > 0 && data.description.size() <= 2000 &&
        data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidJobApplicationData(data) {
      return data.jobId is string && isValidId(data.jobId) &&
        data.applicantId is string && data.applicantId.size() > 0 && data.applicantId.size() <= 128 &&
        data.jobTitle is string && data.jobTitle.size() > 0 && data.jobTitle.size() <= 160 &&
        data.applicantName is string && data.applicantName.size() > 0 && data.applicantName.size() <= 120 &&
        data.applicantPhone is string && data.applicantPhone.size() > 0 && data.applicantPhone.size() <= 30 &&
        (!('applicantNotes' in data) || (data.applicantNotes is string && data.applicantNotes.size() <= 1000)) &&
        (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 150)) &&
        (!('employerId' in data) || (data.employerId is string && data.employerId.size() <= 128)) &&
        data.status in ['pending', 'shortlisted', 'hired', 'rejected'];
    }

    function isValidScrapRequestData(data) {
      return data.customerId is string && data.customerId.size() > 0 && data.customerId.size() <= 128 &&
        data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 30 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 40 &&
        data.categoryLabel is string && data.categoryLabel.size() > 0 && data.categoryLabel.size() <= 120 &&
        data.estimatedWeight is string && data.estimatedWeight.size() > 0 && data.estimatedWeight.size() <= 60 &&
        data.pickupAddress is string && data.pickupAddress.size() > 0 && data.pickupAddress.size() <= 500 &&
        data.locality is string && data.locality.size() > 0 && data.locality.size() <= 100 &&
        data.pincode is string && data.pincode.size() > 0 && data.pincode.size() <= 16 &&
        (!('offers' in data) || (data.offers is list && data.offers.size() <= 50)) &&
        data.status in ['open', 'offers_received', 'accepted', 'pickup_scheduled', 'picked_up', 'completed', 'cancelled'];
    }

    // Strict allowlist for PII-free open scrap summaries (no customerName, customerPhone, pickupAddress, selectedBuyer*)
    function isValidPublicScrapListing(data) {
      return data.keys().hasAll(['id', 'category', 'categoryLabel', 'estimatedWeight', 'locality', 'pincode', 'status']) &&
        data.keys().hasOnly([
          'id', 'category', 'categoryLabel', 'estimatedWeight', 'description',
          'photos', 'locality', 'pincode', 'approxWeightKg', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        !('customerId' in data) &&
        !('customerName' in data) &&
        !('customerPhone' in data) &&
        !('pickupAddress' in data) &&
        !('selectedBuyerId' in data) &&
        !('selectedBuyerName' in data) &&
        !('selectedBuyerPhone' in data) &&
        data.id is string && isValidId(data.id) &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 40 &&
        data.categoryLabel is string && data.categoryLabel.size() > 0 && data.categoryLabel.size() <= 120 &&
        data.estimatedWeight is string && data.estimatedWeight.size() > 0 && data.estimatedWeight.size() <= 60 &&
        data.locality is string && data.locality.size() > 0 && data.locality.size() <= 100 &&
        data.pincode is string && data.pincode.size() > 0 && data.pincode.size() <= 16 &&
        data.status in ['open', 'offers_received', 'accepted', 'pickup_scheduled', 'picked_up', 'completed', 'cancelled'];
    }

    function isValidScrapOfferData(data) {
      return data.keys().hasAll(['id', 'requestId', 'buyerId', 'buyerName', 'totalOfferAmount', 'pickupTimeEstimate', 'status']) &&
        data.keys().hasOnly([
          'id', 'requestId', 'scrapRequestId', 'buyerId', 'buyerName', 'buyerPhone',
          'pricePerKg', 'totalOfferAmount', 'pickupTimeEstimate', 'notes',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.requestId is string && isValidId(data.requestId) &&
        data.buyerId is string && isValidId(data.buyerId) &&
        data.buyerName is string && data.buyerName.size() > 0 && data.buyerName.size() <= 120 &&
        data.totalOfferAmount is number && data.totalOfferAmount >= 0 &&
        (!('pricePerKg' in data) || (data.pricePerKg is number && data.pricePerKg >= 0)) &&
        data.pickupTimeEstimate is string && data.pickupTimeEstimate.size() > 0 && data.pickupTimeEstimate.size() <= 120 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        data.status in ['pending', 'accepted', 'rejected'];
    }

    function isValidComplaintData(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.description is string && data.description.size() > 0 && data.description.size() <= 2000 &&
        data.status in ['open', 'investigating', 'resolved'] &&
        (!('subject' in data) || (data.subject is string && data.subject.size() <= 200));
    }

    function isValidEmergencyRequestData(data) {
      return data.patientUserId is string && data.patientUserId.size() > 0 && data.patientUserId.size() <= 128 &&
        data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 120 &&
        data.patientPhone is string && data.patientPhone.size() > 0 && data.patientPhone.size() <= 30 &&
        data.patientAge is number && data.patientAge >= 0 && data.patientAge <= 130 &&
        data.symptoms is string && data.symptoms.size() > 0 && data.symptoms.size() <= 2000 &&
        data.locality is string && data.locality.size() > 0 && data.locality.size() <= 100 &&
        data.status in ['searching', 'pending', 'accepted', 'doctor_on_the_way', 'on_the_way', 'completed', 'cancelled'];
    }

    // Strict non-PII allowlists for dispatch collections (ban customerName, phone, address, landmarks, symptoms, patientId)
    function isValidRideDispatchData(data) {
      return data.keys().hasAll(['id', 'rideId', 'vehicleType', 'pickupLocality', 'dropLocality', 'estimatedFare', 'status']) &&
        data.keys().hasOnly([
          'id', 'rideId', 'customerId', 'vehicleType', 'pickupLocality', 'dropLocality', 'distanceKm',
          'estimatedFare', 'suggestedFare', 'customerProposedFare',
          'agreedFare', 'agreedAt', 'confirmedAt', 'status', 'routingStatus',
          'assignedDriverId', 'confirmedDriverId', 'driverName', 'vehicleNumber', 'driverRating',
          'eligibleDriverIds', 'rejectedDriverIds', 'activeDriverOffers', 'negotiationHistory',
          'currentRound', 'maxNegotiationRounds', 'expiresAt', 'expiresAtMs',
          'createdAt', 'updatedAt'
        ]) &&
        !('customerName' in data) &&
        !('customerPhone' in data) &&
        !('driverPhone' in data) &&
        !('pickupLocation' in data) &&
        !('dropLocation' in data) &&
        !('pickupLandmark' in data) &&
        !('dropLandmark' in data) &&
        data.id is string && isValidId(data.id) &&
        data.rideId is string && isValidId(data.rideId) &&
        data.vehicleType in ['toto', 'auto', 'taxi'] &&
        data.pickupLocality is string && data.pickupLocality.size() > 0 && data.pickupLocality.size() <= 120 &&
        data.dropLocality is string && data.dropLocality.size() > 0 && data.dropLocality.size() <= 120 &&
        data.estimatedFare is number && data.estimatedFare >= 0 &&
        (!('customerProposedFare' in data) || (data.customerProposedFare is number && data.customerProposedFare >= 10)) &&
        (!('agreedFare' in data) || (data.agreedFare is number && data.agreedFare >= 10)) &&
        (!('expiresAtMs' in data) || (data.expiresAtMs is number && data.expiresAtMs > 0)) &&
        (!('eligibleDriverIds' in data) || data.eligibleDriverIds is list) &&
        (!('rejectedDriverIds' in data) || data.rejectedDriverIds is list) &&
        data.status in [
          'REQUESTED', 'OFFER_SENT', 'COUNTER_OFFERED', 'CUSTOMER_ACCEPTED', 'RIDER_ACCEPTED',
          'CONFIRMED', 'REJECTED', 'EXPIRED', 'CANCELLED', 'PICKUP', 'IN_PROGRESS', 'COMPLETED',
          'requested', 'searching', 'accepted', 'driver_arriving', 'ride_started', 'completed', 'cancelled'
        ];
    }

    function isValidNotificationTokenData(data) {
      return data.keys().hasAll(['id', 'uid', 'role', 'token', 'fcmEnabled', 'permissionStatus', 'platform', 'channelId', 'active']) &&
        data.keys().hasOnly([
          'id', 'uid', 'role', 'entityId', 'vehicleType', 'locality',
          'token', 'fcmEnabled', 'permissionStatus', 'platform', 'channelId',
          'active', 'userAgent', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.uid is string && isValidId(data.uid) &&
        data.role is string && data.role.size() > 0 && data.role.size() <= 32 &&
        data.token is string && data.token.size() > 0 && data.token.size() <= 512 &&
        data.fcmEnabled is bool &&
        data.active is bool &&
        data.permissionStatus in ['granted', 'denied', 'default', 'unsupported'] &&
        data.platform in ['android_pwa', 'web', 'ios_pwa'];
    }

    function isValidRideNotificationLogData(data) {
      return data.keys().hasAll(['id', 'rideId', 'recipientRole', 'locality', 'vehicleType', 'channel', 'eventType', 'deliveryStatus', 'dedupKey', 'timestamp']) &&
        data.keys().hasOnly([
          'id', 'rideId', 'recipientRole', 'recipientId', 'recipientLabel',
          'locality', 'vehicleType', 'channel', 'eventType', 'deliveryStatus',
          'dedupKey', 'timestamp', 'details'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.rideId is string && isValidId(data.rideId) &&
        data.recipientRole in ['driver', 'admin', 'customer'] &&
        data.vehicleType in ['toto', 'auto', 'taxi'] &&
        data.channel in ['fcm', 'pwa_local', 'in_app'] &&
        data.deliveryStatus in ['dispatched', 'seen', 'clicked', 'muted', 'failed'];
    }

    function isValidDeliveryDispatchData(data) {
      return data.keys().hasAll(['id', 'pickupLocality', 'dropLocality', 'estimatedPrice', 'status']) &&
        data.keys().hasOnly([
          'id', 'pickupLocality', 'dropLocality', 'parcelCategory', 'weightCategory',
          'estimatedPrice', 'status', 'assignedDeliveryPersonId', 'createdAt', 'updatedAt'
        ]);
    }

    function isValidEmergencyDispatchData(data) {
      return data.keys().hasAll(['id', 'locality', 'pincode', 'priority', 'requestType', 'status']) &&
        data.keys().hasOnly([
          'id', 'locality', 'pincode', 'priority', 'requestType',
          'consultationFee', 'crossLocalityApproved', 'status', 'assignedDoctorId',
          'createdAt', 'updatedAt'
        ]);
    }

    function isValidRoutingConfigData(data) {
      return data.keys().hasAll(['globalCrossLocalityEnabled', 'rulesByLocality']) &&
        data.keys().hasOnly([
          'globalCrossLocalityEnabled', 'rulesByLocality', 'updatedBy', 'updatedAt'
        ]) &&
        data.globalCrossLocalityEnabled is bool &&
        data.rulesByLocality is map;
    }

    function isValidRoutingAlertData(data) {
      return data.keys().hasAll(['id', 'requestId', 'serviceCategory', 'requestLocality', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'requestId', 'serviceCategory', 'requestLocality',
          'vehicleType', 'serviceRequired', 'message', 'status',
          'createdAt', 'resolvedAt'
        ]) &&
        data.id is string && isValidId(data.id) &&
        data.requestId is string && data.requestId.size() > 0 && data.requestId.size() <= 128 &&
        data.serviceCategory in ['shop_order', 'delivery', 'ride', 'service'] &&
        data.requestLocality is string && data.requestLocality.size() > 0 && data.requestLocality.size() <= 120 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 500 &&
        data.status in ['open', 'resolved'];
    }

    function isOwnerOfUnavailableRoutingRequest(data) {
      return isSignedIn() &&
        data.id == ('rt-alert-' + data.requestId) &&
        isValidId(data.requestId) &&
        (
          (
            data.serviceCategory == 'shop_order' &&
            existsAfter(/databases/$(database)/documents/orders/$(data.requestId)) &&
            getAfter(/databases/$(database)/documents/orders/$(data.requestId)).data.customerId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/orders/$(data.requestId)).data.routingStatus == 'unavailable_in_locality' &&
            getAfter(/databases/$(database)/documents/orders/$(data.requestId)).data.pickupLocality == data.requestLocality
          ) ||
          (
            data.serviceCategory == 'delivery' &&
            existsAfter(/databases/$(database)/documents/deliveries/$(data.requestId)) &&
            getAfter(/databases/$(database)/documents/deliveries/$(data.requestId)).data.customerId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/deliveries/$(data.requestId)).data.routingStatus == 'unavailable_in_locality' &&
            getAfter(/databases/$(database)/documents/deliveries/$(data.requestId)).data.pickupLocality == data.requestLocality
          ) ||
          (
            data.serviceCategory == 'ride' &&
            existsAfter(/databases/$(database)/documents/rideBookings/$(data.requestId)) &&
            getAfter(/databases/$(database)/documents/rideBookings/$(data.requestId)).data.customerId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/rideBookings/$(data.requestId)).data.routingStatus == 'unavailable_in_locality' &&
            getAfter(/databases/$(database)/documents/rideBookings/$(data.requestId)).data.pickupLocality == data.requestLocality
          ) ||
          (
            data.serviceCategory == 'service' &&
            existsAfter(/databases/$(database)/documents/serviceRequests/$(data.requestId)) &&
            getAfter(/databases/$(database)/documents/serviceRequests/$(data.requestId)).data.customerId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/serviceRequests/$(data.requestId)).data.routingStatus == 'unavailable_in_locality' &&
            getAfter(/databases/$(database)/documents/serviceRequests/$(data.requestId)).data.locality == data.requestLocality
          )
        );
    }

    function isValidAdminActivityData(data) {
      return data.keys().hasAll(['id', 'adminEmail', 'action', 'details', 'timestamp']) &&
        data.keys().hasOnly(['id', 'adminEmail', 'action', 'details', 'timestamp']) &&
        data.id is string && isValidId(data.id) &&
        data.adminEmail is string && data.adminEmail.size() > 0 && data.adminEmail.size() <= 150 &&
        data.action is string && data.action.size() > 0 && data.action.size() <= 150 &&
        data.details is string && data.details.size() > 0 && data.details.size() <= 1000 &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64;
    }

    // =========================================================================
    // PARAMETERIZED UPDATE HELPERS (LEAN EXPRESSION BUDGET < 1000 IN BOTH PASSES)
    // =========================================================================
    function isOrderImmutableFieldsMatch(inc, ext) {
      return inc.customerId == ext.customerId &&
        inc.shopId == ext.shopId &&
        (!('shopOwnerId' in ext) || (('shopOwnerId' in inc) && inc.shopOwnerId == ext.shopOwnerId)) &&
        inc.items == ext.items &&
        inc.subtotal == ext.subtotal &&
        inc.deliveryFee == ext.deliveryFee &&
        inc.discount == ext.discount &&
        inc.total == ext.total;
    }

    function canShopkeeperProgressOrderStatus(es, ins) {
      return (es in ['pending', 'placed'] && ins in ['confirmed', 'rejected']) ||
        (es == 'confirmed' && ins in ['confirmed', 'preparing', 'packed', 'ready_for_dispatch']) ||
        (es == 'preparing' && ins in ['preparing', 'packed', 'ready_for_dispatch']) ||
        (es in ['packed', 'ready_for_dispatch'] && ins in ['packed', 'ready_for_dispatch', 'out_for_delivery']);
    }

    function canRiderProgressOrder(diffKeys) {
      return ('riderId' in existing()) &&
        isApprovedDeliveryOwner(existing().riderId) &&
        diffKeys.hasOnly(['status', 'updatedAt']) &&
        (
          (existing().status in ['confirmed', 'packed', 'ready_for_dispatch'] && incoming().status == 'out_for_delivery') ||
          (existing().status == 'out_for_delivery' && incoming().status == 'delivered')
        );
    }

    function canCustomerUpdateRideBookingNonConfirm() {
      return (
        incoming().status in ['CANCELLED', 'cancelled'] &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'updatedAt'])
      ) ||
      (
        incoming().status == 'EXPIRED' &&
        !('driverId' in existing()) &&
        ('expiresAtMs' in existing()) &&
        request.time.toMillis() > existing().expiresAtMs &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'expiredAt', 'updatedAt'])
      ) ||
      (
        incoming().status in ['REQUESTED', 'OFFER_SENT', 'COUNTER_OFFERED'] &&
        (!('customerProposedFare' in incoming()) || (incoming().customerProposedFare is number && incoming().customerProposedFare >= 10)) &&
        !('driverId' in incoming()) &&
        !('agreedFare' in incoming()) &&
        !('driverId' in existing()) &&
        existing().status in ['REQUESTED', 'OFFER_SENT', 'COUNTER_OFFERED', 'CUSTOMER_ACCEPTED', 'RIDER_ACCEPTED', 'requested', 'searching'] &&
        (!('expiresAtMs' in existing()) || request.time.toMillis() <= existing().expiresAtMs) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'customerProposedFare', 'activeDriverOffers',
          'negotiationHistory', 'currentRound', 'expiresAt', 'expiresAtMs', 'updatedAt'
        ])
      );
    }

    function canDriverProgressRideBooking() {
      return incoming().status in ['PICKUP', 'driver_arriving', 'IN_PROGRESS', 'ride_started', 'COMPLETED', 'completed'] &&
        ('driverId' in incoming()) &&
        ('driverId' in existing()) &&
        incoming().driverId == existing().driverId &&
        incoming().customerId == existing().customerId &&
        isApprovedDriverOwner(existing().driverId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt']) &&
        (
          (existing().status in ['CONFIRMED', 'accepted'] && incoming().status in ['PICKUP', 'driver_arriving']) ||
          (existing().status in ['PICKUP', 'driver_arriving'] && incoming().status in ['IN_PROGRESS', 'ride_started']) ||
          (existing().status in ['IN_PROGRESS', 'ride_started'] && incoming().status in ['COMPLETED', 'completed'])
        );
    }

    function isRideDispatchInvariantMatch() {
      return incoming().id == existing().id &&
        incoming().rideId == existing().rideId &&
        (!('customerId' in existing()) || incoming().customerId == existing().customerId) &&
        incoming().vehicleType == existing().vehicleType &&
        (!('agreedFare' in existing()) || existing().agreedFare <= 0 || (('agreedFare' in incoming()) && incoming().agreedFare == existing().agreedFare));
    }

    function isBiddableRideStatus(s) {
      return s in ['REQUESTED', 'OFFER_SENT', 'COUNTER_OFFERED', 'CUSTOMER_ACCEPTED', 'RIDER_ACCEPTED', 'requested', 'searching'];
    }

    function isConfirmDispatchPayloadValid(diffKeys) {
      return ('agreedFare' in incoming()) &&
        incoming().agreedFare is number &&
        incoming().agreedFare >= 10 &&
        diffKeys.hasOnly([
          'status', 'routingStatus', 'assignedDriverId', 'confirmedDriverId',
          'driverName', 'vehicleNumber', 'driverRating', 'agreedFare', 'agreedAt',
          'confirmedAt', 'activeDriverOffers', 'negotiationHistory', 'updatedAt'
        ]);
    }

    function canCustomerUpdateRideDispatch(diffKeys) {
      return ('customerId' in existing()) &&
        existing().customerId == request.auth.uid &&
        (
          (
            diffKeys.hasOnly(['status', 'updatedAt']) &&
            incoming().status in ['CANCELLED', 'cancelled', 'EXPIRED']
          ) ||
          (
            !('confirmedDriverId' in existing()) &&
            isBiddableRideStatus(existing().status) &&
            (
              (
                incoming().status == 'COUNTER_OFFERED' &&
                !('confirmedDriverId' in incoming()) &&
                !('assignedDriverId' in incoming()) &&
                !('agreedFare' in incoming()) &&
                diffKeys.hasOnly([
                  'status', 'customerProposedFare', 'activeDriverOffers',
                  'negotiationHistory', 'currentRound', 'expiresAt', 'expiresAtMs', 'updatedAt'
                ])
              ) ||
              (
                incoming().status == 'CONFIRMED' &&
                ('confirmedDriverId' in incoming()) &&
                incoming().confirmedDriverId is string && incoming().confirmedDriverId.size() > 0 &&
                isConfirmDispatchPayloadValid(diffKeys)
              )
            )
          )
        );
    }

    function canDriverUpdateRideDispatch(drvId, diffKeys) {
      return (
        ('confirmedDriverId' in existing()) &&
        incoming().status in ['PICKUP', 'driver_arriving', 'IN_PROGRESS', 'ride_started', 'COMPLETED', 'completed'] &&
        existing().confirmedDriverId == drvId &&
        incoming().confirmedDriverId == existing().confirmedDriverId &&
        diffKeys.hasOnly(['status', 'updatedAt']) &&
        (
          (existing().status in ['CONFIRMED', 'accepted'] && incoming().status in ['PICKUP', 'driver_arriving']) ||
          (existing().status in ['PICKUP', 'driver_arriving'] && incoming().status in ['IN_PROGRESS', 'ride_started']) ||
          (existing().status in ['IN_PROGRESS', 'ride_started'] && incoming().status in ['COMPLETED', 'completed'])
        )
      ) ||
      (
        !('confirmedDriverId' in existing()) &&
        ('eligibleDriverIds' in existing()) &&
        drvId in existing().eligibleDriverIds &&
        (
          (
            incoming().status == 'EXPIRED' &&
            diffKeys.hasOnly(['status', 'updatedAt'])
          ) ||
          (
            !('agreedFare' in incoming()) &&
            !('confirmedDriverId' in incoming()) &&
            incoming().status in [existing().status, 'REJECTED'] &&
            diffKeys.hasOnly(['rejectedDriverIds', 'activeDriverOffers', 'negotiationHistory', 'status', 'updatedAt'])
          ) ||
          (
            isBiddableRideStatus(existing().status) &&
            (
              (
                incoming().status == 'COUNTER_OFFERED' &&
                !('confirmedDriverId' in incoming()) &&
                !('agreedFare' in incoming()) &&
                diffKeys.hasOnly([
                  'status', 'currentRound', 'activeDriverOffers', 'negotiationHistory',
                  'expiresAt', 'expiresAtMs', 'updatedAt'
                ])
              ) ||
              (
                incoming().status == 'CONFIRMED' &&
                incoming().confirmedDriverId == drvId &&
                incoming().assignedDriverId == drvId &&
                (
                  incoming().agreedFare == existing().customerProposedFare ||
                  incoming().agreedFare == existing().estimatedFare
                ) &&
                isConfirmDispatchPayloadValid(diffKeys)
              )
            )
          )
        )
      );
    }

    function checkDispatchDriverDoc(drvData, drvId, diffKeys) {
      return checkApprovedOwnedEntity(drvData) &&
        existing().vehicleType == drvData.vehicleType &&
        canDriverUpdateRideDispatch(drvId, diffKeys);
    }

    function checkDispatchDriverPartner(pa, diffKeys) {
      return pa.status == 'active' &&
        pa.role == 'driver' &&
        ('linkedEntityId' in pa) &&
        pa.linkedEntityId is string &&
        pa.linkedEntityId.size() > 0 &&
        exists(/databases/$(database)/documents/drivers/$(pa.linkedEntityId)) &&
        checkDispatchDriverDoc(get(/databases/$(database)/documents/drivers/$(pa.linkedEntityId)).data, pa.linkedEntityId, diffKeys);
    }

    function canNonAdminUpdateRideDispatch(diffKeys) {
      return canCustomerUpdateRideDispatch(diffKeys) ||
        (
          exists(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)) &&
          checkDispatchDriverPartner(get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data, diffKeys)
        );
    }

    // =========================================================================
    // DEFAULT DENY CATCH-ALL (GLOBAL SAFETY NET)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // CUSTOMERS (STRICT PRIVATE PII ISOLATION & EXACT PHONE VERIFICATION)
    // =========================================================================
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && (isOwner(customerId) || isAdmin());
      allow list: if isAdmin() || (
        isSignedIn() && (
          ('id' in existing() && existing().id == request.auth.uid) ||
          ('userId' in existing() && existing().userId == request.auth.uid)
        )
      );
      allow create: if isValidId(customerId) &&
        isValidCustomerData(incoming()) &&
        (
          isAdmin() ||
          (
            isOwner(customerId) &&
            (!('id' in incoming()) || incoming().id == request.auth.uid) &&
            (!('userId' in incoming()) || incoming().userId == request.auth.uid)
          )
        );
      allow update: if isValidId(customerId) &&
        (
          isAdmin() ||
          (
            isOwner(customerId) &&
            (!('id' in incoming()) || incoming().id == request.auth.uid) &&
            (!('userId' in incoming()) || incoming().userId == request.auth.uid) &&
            (!('id' in existing()) || incoming().id == existing().id) &&
            (!('userId' in existing()) || incoming().userId == existing().userId)
          )
        ) &&
        isValidCustomerData(incoming());
      allow delete: if isAdmin();
    }

    // =========================================================================
    // ADMIN-ISSUED PARTNER ROLE ACCOUNTS & HASHED MOBILE LOGIN LOOKUP
    // =========================================================================
    match /partnerAccounts/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(uid) &&
        isAdmin() &&
        isValidPartnerAccountData(incoming()) &&
        incoming().uid == uid;
      allow delete: if isAdmin();
    }

    match /phoneAuthLookup/{phoneHash} {
      allow get: if isValidId(phoneHash);
      allow list: if false;
      allow create, update: if isValidId(phoneHash) &&
        isAdmin() &&
        isValidPhoneAuthLookupData(incoming());
      allow delete: if isAdmin();
    }

    // =========================================================================
    // PRIVATE PARTNER DIRECTORY: SHOPS (ADMIN PROVISIONED, OWNER & ADMIN ONLY)
    // =========================================================================
    match /shops/{shopId} {
      allow get: if isValidId(shopId) && (isAdmin() || (isSignedIn() && ('ownerId' in existing()) && existing().ownerId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && ('ownerId' in existing()) && existing().ownerId == request.auth.uid);
      allow create: if isValidId(shopId) &&
        isAdmin() &&
        isValidShopData(incoming());
      allow update: if isValidId(shopId) &&
        isSignedIn() &&
        isValidShopData(incoming()) &&
        (
          isAdmin() ||
          (
            isApprovedShopOwner(shopId) &&
            incoming().ownerId == existing().ownerId &&
            incoming().status == existing().status &&
            !incoming().diff(existing()).affectedKeys().hasAny(['status', 'isVerified', 'ownerId'])
          )
        );
      allow delete: if isAdmin();
    }

    match /publicShops/{shopId} {
      allow get: if isValidId(shopId) && (
        isAdmin() ||
        (
          existing().status == 'approved' &&
          isShopApproved(shopId) &&
          ('ownerId' in get(/databases/$(database)/documents/shops/$(shopId)).data) &&
          isActivePartnerOwnerAccount(get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId, 'shopkeeper', shopId)
        )
      );
      allow list: if existing().status == 'approved' || isAdmin();
      allow create, update: if isValidId(shopId) &&
        isAdmin() &&
        isValidPublicShopCard(incoming()) &&
        incoming().id == shopId &&
        isAfterShopApprovedWithActiveOwner(shopId, incoming().status);
      allow delete: if isAdmin();
    }

    // =========================================================================
    // PRIVATE PRODUCTS (ACTIVE APPROVED SHOP OWNER & ADMIN ONLY; CONTAINS ownerId) & PUBLIC CARDS (NO ownerId)
    // =========================================================================
    match /products/{productId} {
      allow get: if isValidId(productId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          ('ownerId' in existing()) &&
          existing().ownerId == request.auth.uid &&
          ('shopId' in existing()) &&
          isApprovedShopOwner(existing().shopId)
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() &&
        ('ownerId' in existing()) &&
        existing().ownerId == request.auth.uid &&
        ('shopId' in existing()) &&
        isApprovedShopOwner(existing().shopId)
      );
      allow create: if isValidId(productId) &&
        isSignedIn() &&
        isValidProductData(incoming()) &&
        (
          isAdmin() ||
          (
            incoming().ownerId == request.auth.uid &&
            isApprovedShopOwner(incoming().shopId) &&
            incoming().shopStatus == 'approved'
          )
        );
      allow update: if isValidId(productId) &&
        isSignedIn() &&
        (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().ownerId == existing().ownerId &&
            incoming().shopId == existing().shopId &&
            incoming().shopStatus == existing().shopStatus &&
            !incoming().diff(existing()).affectedKeys().hasAny(['shopStatus', 'ownerId', 'shopId', 'id']) &&
            isApprovedShopOwner(existing().shopId)
          )
        ) &&
        isValidProductData(incoming());
      allow delete: if isValidId(productId) &&
        isSignedIn() &&
        (isAdmin() || (existing().ownerId == request.auth.uid && isApprovedShopOwner(existing().shopId)));
    }

    // PUBLIC NON-PII PRODUCT CARDS (NO ownerId; requires BOTH shopStatus == 'approved' AND parent shop status == 'approved')
    match /publicProducts/{productId} {
      allow get: if isValidId(productId) && (
        isAdmin() ||
        (existing().shopStatus == 'approved' && isShopApproved(existing().shopId))
      );
      allow list: if isAdmin() ||
        (existing().shopStatus == 'approved' && isShopApproved(existing().shopId));
      allow create: if isValidId(productId) &&
        isSignedIn() &&
        isValidPublicProductCard(incoming()) &&
        incoming().id == productId &&
        (
          (
            isAdmin() &&
            existsAfter(/databases/$(database)/documents/shops/$(incoming().shopId)) &&
            getAfter(/databases/$(database)/documents/shops/$(incoming().shopId)).data.status == incoming().shopStatus
          ) ||
          (
            isApprovedShopOwner(incoming().shopId) &&
            incoming().shopStatus == 'approved' &&
            existsAfter(/databases/$(database)/documents/products/$(productId)) &&
            getAfter(/databases/$(database)/documents/products/$(productId)).data.ownerId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/products/$(productId)).data.shopId == incoming().shopId &&
            getAfter(/databases/$(database)/documents/products/$(productId)).data.shopStatus == 'approved'
          )
        );
      allow update: if isValidId(productId) &&
        isSignedIn() &&
        isValidPublicProductCard(incoming()) &&
        incoming().id == productId &&
        (
          (
            isAdmin() &&
            existsAfter(/databases/$(database)/documents/shops/$(incoming().shopId)) &&
            getAfter(/databases/$(database)/documents/shops/$(incoming().shopId)).data.status == incoming().shopStatus
          ) ||
          (
            existing().shopId == incoming().shopId &&
            incoming().shopStatus == existing().shopStatus &&
            !incoming().diff(existing()).affectedKeys().hasAny(['shopStatus', 'shopId', 'id']) &&
            isApprovedShopOwner(existing().shopId) &&
            existsAfter(/databases/$(database)/documents/products/$(productId)) &&
            getAfter(/databases/$(database)/documents/products/$(productId)).data.ownerId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/products/$(productId)).data.shopId == existing().shopId
          )
        );
      allow delete: if isValidId(productId) &&
        isSignedIn() &&
        (isAdmin() || isApprovedShopOwner(existing().shopId));
    }

    // =========================================================================
    // ORDERS (APPROVED RIDER ASSIGNMENT CHECK, IMMUTABLE PRICING;
    // NOTE: Catalog unit-price verification & stock deduction require BACKEND REQUIRED)
    // =========================================================================
    match /orders/{orderId} {
      allow get: if isValidId(orderId) &&
        isSignedIn() &&
        (
          isAdmin() ||
          ('customerId' in existing() && existing().customerId == request.auth.uid) ||
          ('riderId' in existing() && isApprovedDeliveryOwner(existing().riderId)) ||
          ('shopId' in existing() && isApprovedShopOwner(existing().shopId))
        );
      allow list: if isAdmin() ||
        (
          isSignedIn() &&
          (
            ('customerId' in existing() && existing().customerId == request.auth.uid) ||
            ('riderId' in existing() && isApprovedDeliveryOwner(existing().riderId)) ||
            ('shopId' in existing() && isApprovedShopOwner(existing().shopId))
          )
        );
      allow create: if isValidId(orderId) &&
        isSignedIn() &&
        isValidOrderData(incoming()) &&
        incoming().customerId == request.auth.uid &&
        incoming().status == 'pending' &&
        ('pickupLocality' in incoming() && incoming().pickupLocality is string && incoming().pickupLocality.size() > 0 && incoming().pickupLocality.size() <= 120) &&
        ('locality' in incoming() && incoming().locality is string && incoming().locality.size() > 0 && incoming().locality.size() <= 120) &&
        (!('routingStatus' in incoming()) || incoming().routingStatus in ['pending_admin_routing', 'unavailable_in_locality']) &&
        !('riderId' in incoming()) &&
        !('riderPhone' in incoming()) &&
        !('riderLocality' in incoming()) &&
        !('assignmentHistory' in incoming()) &&
        !('returnRequest' in incoming()) &&
        !('rejectionReason' in incoming()) &&
        (!('confirmedByShopkeeper' in incoming()) || incoming().confirmedByShopkeeper == false) &&
        isShopApproved(incoming().shopId) &&
        (!('shopOwnerId' in incoming()) || incoming().shopOwnerId == '' || incoming().shopOwnerId == get(/databases/$(database)/documents/shops/$(incoming().shopId)).data.ownerId);
      allow update: if isValidId(orderId) &&
        isSignedIn() &&
        (
          (isAdmin() && isValidOrderData(incoming())) ||
          (
            isOrderImmutableFieldsMatch(incoming(), existing()) &&
            (
              (
                existing().customerId == request.auth.uid &&
                existing().status in ['pending', 'placed', 'confirmed', 'preparing', 'packed', 'ready_for_dispatch'] &&
                incoming().status == 'cancelled' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              ) ||
              (
                isApprovedShopOwner(existing().shopId) &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'status', 'rejectionReason', 'riderId', 'riderName', 'confirmedByShopkeeper', 'updatedAt'
                ]) &&
                canShopkeeperProgressOrderStatus(existing().status, incoming().status) &&
                (
                  (
                    !incoming().diff(existing()).affectedKeys().hasAny(['riderId', 'riderName']) &&
                    incoming().status != 'out_for_delivery'
                  ) ||
                  (
                    ('riderId' in incoming()) &&
                    incoming().riderId is string &&
                    isEligibleOnlineDeliveryRiderForShop(
                      incoming().riderId,
                      get(/databases/$(database)/documents/shops/$(existing().shopId)).data.locality
                    ) &&
                    incoming().riderName == get(/databases/$(database)/documents/deliveryPersons/$(incoming().riderId)).data.name
                  )
                )
              ) ||
              canRiderProgressOrder(incoming().diff(existing()).affectedKeys())
            )
          )
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // LOCALITIES (PUBLIC READ, STRICT ADMIN WRITE)
    // =========================================================================
    match /localities/{localityId} {
      allow get: if isValidId(localityId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // DRIVERS (ADMIN PROVISIONED, OWNER & ADMIN ONLY - PROTECTS PHONE & LICENSE PII)
    // =========================================================================
    match /drivers/{driverId} {
      allow get: if isValidId(driverId) && (isAdmin() || (isSignedIn() && ('ownerId' in existing()) && existing().ownerId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && ('ownerId' in existing()) && existing().ownerId == request.auth.uid);
      allow create: if isValidId(driverId) &&
        isAdmin() &&
        incoming().name is string && incoming().name.size() <= 120 &&
        incoming().phone is string && incoming().phone.size() <= 30;
      allow update: if isValidId(driverId) &&
        (
          isAdmin() ||
          (
            isSignedIn() &&
            isApprovedDriverOwner(driverId) &&
            incoming().ownerId == existing().ownerId &&
            incoming().status == existing().status &&
            !incoming().diff(existing()).affectedKeys().hasAny(['status', 'approvalStatus', 'ownerId'])
          )
        );
      allow delete: if isAdmin();
    }

    match /publicDrivers/{driverId} {
      allow get: if isValidId(driverId) && (
        isAdmin() ||
        (
          existing().status == 'approved' &&
          isApprovedDriverRecord(driverId) &&
          ('ownerId' in get(/databases/$(database)/documents/drivers/$(driverId)).data) &&
          isActivePartnerOwnerAccount(get(/databases/$(database)/documents/drivers/$(driverId)).data.ownerId, 'driver', driverId)
        )
      );
      allow list: if existing().status == 'approved' || isAdmin();
      allow create: if isValidId(driverId) &&
        isAdmin() &&
        isValidPublicDriverCard(incoming()) &&
        incoming().id == driverId &&
        isAfterDriverApprovedWithActiveOwner(driverId, incoming().status);
      allow update: if isValidId(driverId) &&
        (
          (
            isAdmin() &&
            isAfterDriverApprovedWithActiveOwner(driverId, incoming().status)
          ) ||
          (
            isApprovedDriverOwner(driverId) &&
            incoming().status == existing().status &&
            incoming().status == 'approved' &&
            (!('accountStatus' in incoming()) || incoming().accountStatus == 'active') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'vehicleType', 'locality', 'currentLocation', 'servedLocalities', 'isOnline', 'updatedAt'
            ])
          )
        ) &&
        isValidPublicDriverCard(incoming()) &&
        incoming().id == driverId;
      allow delete: if isAdmin();
    }

    // =========================================================================
    // RIDE BOOKINGS (CUSTOMER & CONFIRMED DRIVER PII PROTECTED;
    // ATOMIC SINGLE-WINNER LOCKING SYNCED VIA runTransaction WITH /rideDispatch)
    // =========================================================================
    match /rideBookings/{rideId} {
      allow get: if isValidId(rideId) &&
        isSignedIn() &&
        (
          isAdmin() ||
          ('customerId' in existing() && existing().customerId == request.auth.uid) ||
          ('driverId' in existing() && isApprovedDriverOwner(existing().driverId))
        );
      allow list: if isAdmin() ||
        (
          isSignedIn() &&
          (
            ('customerId' in existing() && existing().customerId == request.auth.uid) ||
            ('driverId' in existing() && isApprovedDriverOwner(existing().driverId))
          )
        );
      allow create: if isValidId(rideId) &&
        isSignedIn() &&
        incoming().customerId == request.auth.uid &&
        incoming().status in ['REQUESTED', 'OFFER_SENT'] &&
        incoming().vehicleType in ['taxi', 'auto', 'toto'] &&
        incoming().customerName is string && incoming().customerName.size() > 0 && incoming().customerName.size() <= 120 &&
        incoming().customerPhone is string && incoming().customerPhone.size() > 0 && incoming().customerPhone.size() <= 30 &&
        incoming().pickupLocation is string && incoming().pickupLocation.size() > 0 && incoming().pickupLocation.size() <= 200 &&
        incoming().dropLocation is string && incoming().dropLocation.size() > 0 && incoming().dropLocation.size() <= 200 &&
        ('pickupLocality' in incoming() && incoming().pickupLocality is string && incoming().pickupLocality.size() > 0 && incoming().pickupLocality.size() <= 120) &&
        ('dropLocality' in incoming() && incoming().dropLocality is string && incoming().dropLocality.size() > 0 && incoming().dropLocality.size() <= 120) &&
        (!('routingStatus' in incoming()) || incoming().routingStatus in ['pending_admin_routing', 'unavailable_in_locality']) &&
        incoming().estimatedFare is number && incoming().estimatedFare >= 0 &&
        (!('customerProposedFare' in incoming()) || (incoming().customerProposedFare is number && incoming().customerProposedFare >= 10)) &&
        !('driverId' in incoming()) &&
        !('driverName' in incoming()) &&
        !('driverPhone' in incoming()) &&
        !('driverLocality' in incoming()) &&
        !('vehicleNumber' in incoming()) &&
        !('driverRating' in incoming()) &&
        !('agreedFare' in incoming()) &&
        !('assignmentHistory' in incoming());
      allow update: if isValidId(rideId) &&
        isSignedIn() &&
        (!('agreedFare' in existing()) || existing().agreedFare <= 0 || (('agreedFare' in incoming()) && incoming().agreedFare == existing().agreedFare)) &&
        (
          isAdmin() ||
          (
            existing().customerId == request.auth.uid &&
            incoming().customerId == existing().customerId &&
            !(existing().status in ['COMPLETED', 'CANCELLED', 'REJECTED', 'EXPIRED', 'completed', 'cancelled']) &&
            canCustomerUpdateRideBookingNonConfirm()
          ) ||
          (
            incoming().status == 'CONFIRMED' &&
            !('driverId' in existing()) &&
            incoming().customerId == existing().customerId &&
            existing().status in ['REQUESTED', 'OFFER_SENT', 'COUNTER_OFFERED', 'CUSTOMER_ACCEPTED', 'RIDER_ACCEPTED', 'requested', 'searching'] &&
            ('driverId' in incoming()) &&
            incoming().driverId is string && incoming().driverId.size() > 0 &&
            ('agreedFare' in incoming()) &&
            incoming().agreedFare is number && incoming().agreedFare >= 10 &&
            existsAfter(/databases/$(database)/documents/rideDispatch/$(rideId)) &&
            getAfter(/databases/$(database)/documents/rideDispatch/$(rideId)).data.status == 'CONFIRMED' &&
            getAfter(/databases/$(database)/documents/rideDispatch/$(rideId)).data.agreedFare == incoming().agreedFare &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'routingStatus', 'driverId', 'driverName', 'driverPhone',
              'driverLocality', 'vehicleNumber', 'driverRating', 'agreedFare', 'agreedAt',
              'confirmedAt', 'activeDriverOffers', 'negotiationHistory', 'updatedAt'
            ]) &&
            (
              (
                existing().customerId == request.auth.uid &&
                (!('expiresAtMs' in existing()) || request.time.toMillis() <= existing().expiresAtMs) &&
                getAfter(/databases/$(database)/documents/rideDispatch/$(rideId)).data.confirmedDriverId == incoming().driverId
              ) ||
              (
                isActiveApprovedDriver() &&
                incoming().driverId == callerDriverId() &&
                getAfter(/databases/$(database)/documents/rideDispatch/$(rideId)).data.confirmedDriverId == callerDriverId()
              )
            )
          ) ||
          canDriverProgressRideBooking()
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // DELIVERY FLEET (ADMIN PROVISIONED, OWNER & ADMIN ONLY) & APPROVED RIDER CARDS
    // =========================================================================
    match /deliveryPersons/{personId} {
      allow get: if isValidId(personId) && (isAdmin() || (isSignedIn() && ('ownerId' in existing()) && existing().ownerId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && ('ownerId' in existing()) && existing().ownerId == request.auth.uid);
      allow create: if isValidId(personId) &&
        isAdmin() &&
        incoming().name is string && incoming().name.size() <= 120 &&
        incoming().phone is string && incoming().phone.size() <= 30;
      allow update: if isValidId(personId) &&
        (
          isAdmin() ||
          (
            isSignedIn() &&
            isApprovedDeliveryOwner(personId) &&
            incoming().ownerId == existing().ownerId &&
            incoming().status == existing().status &&
            !incoming().diff(existing()).affectedKeys().hasAny(['status', 'ownerId'])
          )
        );
      allow delete: if isAdmin();
    }

    match /publicRiders/{riderId} {
      allow get: if isValidId(riderId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          existing().status == 'approved' &&
          isApprovedRiderRecord(riderId) &&
          ('ownerId' in get(/databases/$(database)/documents/deliveryPersons/$(riderId)).data) &&
          isActivePartnerOwnerAccount(get(/databases/$(database)/documents/deliveryPersons/$(riderId)).data.ownerId, 'delivery', riderId)
        )
      );
      allow list: if (isSignedIn() && existing().status == 'approved') || isAdmin();
      allow create: if isValidId(riderId) &&
        isAdmin() &&
        isValidPublicRiderCard(incoming()) &&
        incoming().id == riderId &&
        isAfterRiderApprovedWithActiveOwner(riderId, incoming().status);
      allow update: if isValidId(riderId) &&
        isValidPublicRiderCard(incoming()) &&
        incoming().id == riderId &&
        (
          (
            isAdmin() &&
            isAfterRiderApprovedWithActiveOwner(riderId, incoming().status)
          ) ||
          (
            isApprovedDeliveryOwner(riderId) &&
            incoming().status == existing().status &&
            incoming().status == 'approved' &&
            (!('accountStatus' in incoming()) || incoming().accountStatus == 'active') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'locality', 'currentLocation', 'servedLocalities', 'isOnline', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // PARCEL DELIVERIES (CUSTOMER, ASSIGNED DELIVERY RIDER, ADMIN ONLY;
    // NOTE: Atomic unassigned courier claiming requires BACKEND REQUIRED)
    // =========================================================================
    match /deliveries/{deliveryId} {
      allow get: if isValidId(deliveryId) &&
        isSignedIn() &&
        (
          isAdmin() ||
          ('customerId' in existing() && existing().customerId == request.auth.uid) ||
          ('assignedDeliveryPersonId' in existing() && isApprovedDeliveryOwner(existing().assignedDeliveryPersonId))
        );
      allow list: if isAdmin() ||
        (
          isSignedIn() &&
          (
            ('customerId' in existing() && existing().customerId == request.auth.uid) ||
            ('assignedDeliveryPersonId' in existing() && isApprovedDeliveryOwner(existing().assignedDeliveryPersonId))
          )
        );
      allow create: if isValidId(deliveryId) &&
        isSignedIn() &&
        incoming().customerId == request.auth.uid &&
        incoming().status == 'pending_assignment' &&
        incoming().senderName is string && incoming().senderName.size() > 0 && incoming().senderName.size() <= 120 &&
        incoming().senderPhone is string && incoming().senderPhone.size() > 0 && incoming().senderPhone.size() <= 30 &&
        incoming().senderAddress is string && incoming().senderAddress.size() > 0 && incoming().senderAddress.size() <= 500 &&
        incoming().receiverName is string && incoming().receiverName.size() > 0 && incoming().receiverName.size() <= 120 &&
        incoming().receiverPhone is string && incoming().receiverPhone.size() > 0 && incoming().receiverPhone.size() <= 30 &&
        incoming().receiverAddress is string && incoming().receiverAddress.size() > 0 && incoming().receiverAddress.size() <= 500 &&
        ('pickupLocality' in incoming() && incoming().pickupLocality is string && incoming().pickupLocality.size() > 0 && incoming().pickupLocality.size() <= 120) &&
        ('dropLocality' in incoming() && incoming().dropLocality is string && incoming().dropLocality.size() > 0 && incoming().dropLocality.size() <= 120) &&
        (!('routingStatus' in incoming()) || incoming().routingStatus in ['pending_admin_routing', 'unavailable_in_locality']) &&
        incoming().estimatedPrice is number && incoming().estimatedPrice >= 0 &&
        !('assignedDeliveryPersonId' in incoming()) &&
        !('assignedDeliveryPersonName' in incoming()) &&
        !('assignedDeliveryPersonPhone' in incoming()) &&
        !('assignedDeliveryPersonLocality' in incoming()) &&
        !('assignmentHistory' in incoming());
      allow update: if isValidId(deliveryId) &&
        isSignedIn() &&
        (
          isAdmin() ||
          (
            existing().customerId == request.auth.uid &&
            incoming().customerId == existing().customerId &&
            existing().status in ['pending_assignment', 'assigned'] &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            ('assignedDeliveryPersonId' in existing()) &&
            ('assignedDeliveryPersonId' in incoming()) &&
            isApprovedDeliveryOwner(existing().assignedDeliveryPersonId) &&
            incoming().customerId == existing().customerId &&
            incoming().assignedDeliveryPersonId == existing().assignedDeliveryPersonId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            (
              (existing().status == 'assigned' && incoming().status == 'accepted') ||
              (existing().status == 'accepted' && incoming().status == 'picked_up') ||
              (existing().status == 'picked_up' && incoming().status == 'on_the_way') ||
              (existing().status == 'on_the_way' && incoming().status in ['delivered', 'failed'])
            )
          )
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // PRIVATE SERVICE PROVIDERS & CONSISTENT SERVICE REQUEST OWNERSHIP
    // Convention: serviceRequests.providerId ALWAYS stores /serviceProviders/{providerId} doc ID;
    // serviceRequests.providerOwnerId stores that provider's Firebase Auth UID.
    // Unassigned provider claiming requires BACKEND REQUIRED.
    // =========================================================================
    match /serviceProviders/{providerId} {
      allow get: if isValidId(providerId) && (isAdmin() || (isSignedIn() && ('ownerId' in existing()) && existing().ownerId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && ('ownerId' in existing()) && existing().ownerId == request.auth.uid);
      allow create: if isValidId(providerId) &&
        isAdmin() &&
        incoming().name is string && incoming().name.size() <= 120 &&
        incoming().phone is string && incoming().phone.size() <= 30;
      allow update: if isValidId(providerId) &&
        (
          isAdmin() ||
          (
            isSignedIn() &&
            isApprovedServiceProviderOwner(providerId) &&
            incoming().ownerId == existing().ownerId &&
            incoming().status == existing().status &&
            !incoming().diff(existing()).affectedKeys().hasAny(['status', 'ownerId'])
          )
        );
      allow delete: if isAdmin();
    }

    match /publicServiceProviders/{providerId} {
      allow get: if isValidId(providerId) && (
        isAdmin() ||
        (
          existing().status == 'approved' &&
          exists(/databases/$(database)/documents/serviceProviders/$(providerId)) &&
          get(/databases/$(database)/documents/serviceProviders/$(providerId)).data.status == 'approved' &&
          ('ownerId' in get(/databases/$(database)/documents/serviceProviders/$(providerId)).data) &&
          isActivePartnerOwnerAccount(get(/databases/$(database)/documents/serviceProviders/$(providerId)).data.ownerId, 'service_provider', providerId)
        )
      );
      allow list: if existing().status == 'approved' || isAdmin();
      allow create, update: if isValidId(providerId) &&
        isAdmin() &&
        isValidPublicServiceProviderCard(incoming()) &&
        incoming().id == providerId &&
        isAfterProviderApprovedWithActiveOwner(providerId, incoming().status);
      allow delete: if isAdmin();
    }

    match /serviceRequests/{requestId} {
      allow get: if isValidId(requestId) &&
        isSignedIn() &&
        (
          isAdmin() ||
          ('customerId' in existing() && existing().customerId == request.auth.uid) ||
          ('providerId' in existing() && isApprovedServiceProviderOwner(existing().providerId))
        );
      allow list: if isAdmin() ||
        (
          isSignedIn() &&
          (
            ('customerId' in existing() && existing().customerId == request.auth.uid) ||
            ('providerId' in existing() && isApprovedServiceProviderOwner(existing().providerId))
          )
        );
      allow create: if isValidId(requestId) &&
        isSignedIn() &&
        isValidServiceRequestData(incoming()) &&
        incoming().customerId == request.auth.uid &&
        incoming().status == 'requested' &&
        ('locality' in incoming() && incoming().locality is string && incoming().locality.size() > 0 && incoming().locality.size() <= 120) &&
        (!('routingStatus' in incoming()) || incoming().routingStatus in ['pending_admin_routing', 'unavailable_in_locality']) &&
        !('providerId' in incoming()) &&
        !('providerOwnerId' in incoming()) &&
        !('providerName' in incoming()) &&
        !('providerLocality' in incoming()) &&
        !('finalFee' in incoming()) &&
        !('assignmentHistory' in incoming());
      allow update: if isValidId(requestId) &&
        isSignedIn() &&
        isValidServiceRequestData(incoming()) &&
        (
          isAdmin() ||
          (
            existing().customerId == request.auth.uid &&
            incoming().customerId == existing().customerId &&
            incoming().estimatedFee == existing().estimatedFee &&
            !('providerId' in incoming().diff(existing()).affectedKeys()) &&
            !('providerOwnerId' in incoming().diff(existing()).affectedKeys()) &&
            !('providerName' in incoming().diff(existing()).affectedKeys()) &&
            !('finalFee' in incoming().diff(existing()).affectedKeys()) &&
            !(existing().status in ['completed', 'cancelled']) &&
            (
              (
                incoming().status == 'cancelled' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              ) ||
              (
                existing().status == 'requested' &&
                incoming().status == 'requested' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['preferredDate', 'preferredTime', 'issueDescription', 'updatedAt'])
              )
            )
          ) ||
          (
            ('providerId' in existing()) &&
            isApprovedServiceProviderOwner(existing().providerId) &&
            incoming().providerId == existing().providerId &&
            (!('providerOwnerId' in existing()) || incoming().providerOwnerId == existing().providerOwnerId) &&
            incoming().customerId == existing().customerId &&
            incoming().estimatedFee == existing().estimatedFee &&
            !(existing().status in ['completed', 'cancelled']) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'finalFee', 'updatedAt']) &&
            (
              (existing().status == 'accepted' && incoming().status in ['accepted', 'in_progress', 'completed', 'cancelled']) ||
              (existing().status == 'in_progress' && incoming().status in ['in_progress', 'completed', 'cancelled'])
            )
          )
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // PRIVATE JOBS (ADMIN-PROVISIONED EMPLOYER & ADMIN ONLY) & PUBLIC JOB CARDS
    // =========================================================================
    match /jobs/{jobId} {
      allow get: if isValidId(jobId) && (isAdmin() || (isSignedIn() && hasPartnerRole(['employer']) && ('employerId' in existing()) && existing().employerId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && hasPartnerRole(['employer']) && ('employerId' in existing()) && existing().employerId == request.auth.uid);
      allow create: if isValidId(jobId) &&
        isSignedIn() &&
        isValidJobData(incoming()) &&
        (
          isAdmin() ||
          (
            hasPartnerRole(['employer']) &&
            incoming().employerId == request.auth.uid &&
            incoming().status == 'pending'
          )
        );
      allow update: if isValidId(jobId) &&
        isSignedIn() &&
        isValidJobData(incoming()) &&
        (
          isAdmin() ||
          (
            hasPartnerRole(['employer']) &&
            existing().employerId == request.auth.uid &&
            incoming().employerId == existing().employerId &&
            incoming().status == existing().status &&
            !incoming().diff(existing()).affectedKeys().hasAny(['status', 'employerId', 'id'])
          )
        );
      allow delete: if isAdmin();
    }

    match /publicJobs/{jobId} {
      allow get: if isValidId(jobId) && (
        isAdmin() ||
        (
          existing().status == 'approved' &&
          exists(/databases/$(database)/documents/jobs/$(jobId)) &&
          get(/databases/$(database)/documents/jobs/$(jobId)).data.status == 'approved' &&
          ('employerId' in get(/databases/$(database)/documents/jobs/$(jobId)).data) &&
          isActiveEmployerAccount(get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId)
        )
      );
      allow list: if existing().status == 'approved' || isAdmin();
      allow create, update: if isValidId(jobId) &&
        isAdmin() &&
        isValidPublicJobCard(incoming()) &&
        incoming().id == jobId &&
        isAfterJobApprovedWithActiveOwner(jobId, incoming().status);
      allow delete: if isAdmin();
    }

    // =========================================================================
    // JOB APPLICATIONS (VERIFIES REAL APPROVED JOB & REAL JOB OWNER; ANTI-SPOOFING)
    // =========================================================================
    match /jobApplications/{appId} {
      allow get: if isValidId(appId) &&
        isSignedIn() &&
        (isAdmin() || ('applicantId' in existing() && existing().applicantId == request.auth.uid) || ('jobId' in existing() && isJobOwner(existing().jobId)));
      allow list: if isAdmin() ||
        (isSignedIn() && (('applicantId' in existing() && existing().applicantId == request.auth.uid) || ('jobId' in existing() && isJobOwner(existing().jobId))));
      allow create: if isValidId(appId) &&
        isSignedIn() &&
        isValidJobApplicationData(incoming()) &&
        incoming().applicantId == request.auth.uid &&
        incoming().status == 'pending' &&
        exists(/databases/$(database)/documents/jobs/$(incoming().jobId)) &&
        get(/databases/$(database)/documents/jobs/$(incoming().jobId)).data.status == 'approved' &&
        (
          !('employerId' in incoming()) ||
          incoming().employerId == get(/databases/$(database)/documents/jobs/$(incoming().jobId)).data.employerId
        );
      allow update: if isValidId(appId) &&
        isSignedIn() &&
        isValidJobApplicationData(incoming()) &&
        (
          isAdmin() ||
          (
            isJobOwner(existing().jobId) &&
            incoming().jobId == existing().jobId &&
            incoming().applicantId == existing().applicantId &&
            (!('employerId' in existing()) || incoming().employerId == existing().employerId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // COMPLAINTS & TICKETS (PRIVATE CUSTOMER + ADMIN)
    // =========================================================================
    match /complaints/{complaintId} {
      allow get: if isValidId(complaintId) && isSignedIn() && (isAdmin() || ('userId' in existing() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && ('userId' in existing() && existing().userId == request.auth.uid));
      allow create: if isValidId(complaintId) &&
        isSignedIn() &&
        isValidComplaintData(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'open';
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // SCRAP MARKETPLACE: PII-FREE LISTINGS, PRIVATE REQUESTS, ISOLATED OFFERS
    // =========================================================================
    match /publicScrapListings/{requestId} {
      allow get, list: if isAdmin() || hasPartnerRole(['kabari']);
      allow create: if isValidId(requestId) &&
        isSignedIn() &&
        isValidPublicScrapListing(incoming()) &&
        incoming().id == requestId &&
        incoming().status == 'open' &&
        (
          isAdmin() ||
          (
            existsAfter(/databases/$(database)/documents/scrapRequests/$(requestId)) &&
            getAfter(/databases/$(database)/documents/scrapRequests/$(requestId)).data.customerId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/scrapRequests/$(requestId)).data.status == 'open' &&
            getAfter(/databases/$(database)/documents/scrapRequests/$(requestId)).data.locality == incoming().locality
          )
        );
      allow update: if isValidId(requestId) &&
        isSignedIn() &&
        isValidPublicScrapListing(incoming()) &&
        incoming().id == requestId &&
        (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/scrapRequests/$(requestId)) &&
            get(/databases/$(database)/documents/scrapRequests/$(requestId)).data.customerId == request.auth.uid &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            hasPartnerRole(['kabari']) &&
            exists(/databases/$(database)/documents/scrapRequests/$(requestId)) &&
            ('selectedBuyerId' in get(/databases/$(database)/documents/scrapRequests/$(requestId)).data) &&
            get(/databases/$(database)/documents/scrapRequests/$(requestId)).data.selectedBuyerId == request.auth.uid &&
            incoming().status in ['pickup_scheduled', 'picked_up', 'completed'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isAdmin();
    }

    match /scrapRequests/{requestId} {
      allow get: if isValidId(requestId) &&
        isSignedIn() &&
        (
          isAdmin() ||
          ('customerId' in existing() && existing().customerId == request.auth.uid) ||
          (hasPartnerRole(['kabari']) && 'selectedBuyerId' in existing() && existing().selectedBuyerId == request.auth.uid)
        );
      allow list: if isAdmin() ||
        (
          isSignedIn() &&
          (
            ('customerId' in existing() && existing().customerId == request.auth.uid) ||
            (hasPartnerRole(['kabari']) && 'selectedBuyerId' in existing() && existing().selectedBuyerId == request.auth.uid)
          )
        );
      allow create: if isValidId(requestId) &&
        isSignedIn() &&
        isValidScrapRequestData(incoming()) &&
        incoming().customerId == request.auth.uid &&
        incoming().status == 'open' &&
        (!('offers' in incoming()) || incoming().offers.size() == 0) &&
        !('selectedOfferId' in incoming()) &&
        !('selectedBuyerId' in incoming()) &&
        !('selectedBuyerName' in incoming()) &&
        !('selectedBuyerPhone' in incoming()) &&
        !('finalPaidAmount' in incoming());
      allow update: if isValidId(requestId) &&
        isSignedIn() &&
        isValidScrapRequestData(incoming()) &&
        (
          isAdmin() ||
          (
            existing().customerId == request.auth.uid &&
            incoming().customerId == existing().customerId &&
            !(existing().status in ['completed', 'cancelled']) &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            hasPartnerRole(['kabari']) &&
            ('selectedBuyerId' in existing()) &&
            existing().selectedBuyerId == request.auth.uid &&
            incoming().customerId == existing().customerId &&
            incoming().selectedBuyerId == existing().selectedBuyerId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'finalPaidAmount', 'paymentMethod', 'updatedAt']) &&
            (
              (existing().status == 'accepted' && incoming().status in ['pickup_scheduled', 'picked_up']) ||
              (existing().status == 'pickup_scheduled' && incoming().status in ['picked_up', 'completed']) ||
              (existing().status == 'picked_up' && incoming().status == 'completed')
            )
          )
        );
      allow delete: if isAdmin();

      match /offers/{offerId} {
        allow get, list: if isValidId(requestId) &&
          isValidId(offerId) &&
          isSignedIn() &&
          (
            isAdmin() ||
            (hasPartnerRole(['kabari']) && ('buyerId' in existing()) && existing().buyerId == request.auth.uid) ||
            (
              exists(/databases/$(database)/documents/scrapRequests/$(requestId)) &&
              get(/databases/$(database)/documents/scrapRequests/$(requestId)).data.customerId == request.auth.uid
            )
          );
        allow create: if isValidId(requestId) &&
          isValidId(offerId) &&
          isSignedIn() &&
          hasPartnerRole(['kabari']) &&
          isValidScrapOfferData(incoming()) &&
          incoming().requestId == requestId &&
          incoming().buyerId == request.auth.uid &&
          incoming().status == 'pending' &&
          offerId == (requestId + '_' + request.auth.uid) &&
          exists(/databases/$(database)/documents/publicScrapListings/$(requestId)) &&
          get(/databases/$(database)/documents/publicScrapListings/$(requestId)).data.status in ['open', 'offers_received'];
        allow update: if isValidId(requestId) &&
          isValidId(offerId) &&
          isSignedIn() &&
          isValidScrapOfferData(incoming()) &&
          (
            isAdmin() ||
            (
              hasPartnerRole(['kabari']) &&
              existing().buyerId == request.auth.uid &&
              incoming().buyerId == existing().buyerId &&
              incoming().requestId == existing().requestId &&
              existing().status == 'pending' &&
              incoming().status == 'pending' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'pricePerKg', 'totalOfferAmount', 'pickupTimeEstimate', 'notes', 'updatedAt'
              ])
            )
          );
        allow delete: if isAdmin();
      }
    }

    // =========================================================================
    // PRIVATE DOCTOR PARTNERS (ADMIN PROVISIONED, OWNER & ADMIN ONLY)
    // =========================================================================
    match /doctors/{doctorId} {
      allow get: if isValidId(doctorId) && (isAdmin() || (isSignedIn() && ('ownerId' in existing()) && existing().ownerId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && ('ownerId' in existing()) && existing().ownerId == request.auth.uid);
      allow create: if isValidId(doctorId) &&
        isAdmin() &&
        incoming().name is string && incoming().name.size() <= 120;
      allow update: if isValidId(doctorId) &&
        (
          isAdmin() ||
          (
            isSignedIn() &&
            isApprovedDoctorOwner(doctorId) &&
            incoming().ownerId == existing().ownerId &&
            incoming().status == existing().status &&
            !incoming().diff(existing()).affectedKeys().hasAny(['status', 'ownerId'])
          )
        );
      allow delete: if isAdmin();
    }

    match /publicDoctors/{doctorId} {
      allow get: if isValidId(doctorId) && (
        isAdmin() ||
        (
          existing().status == 'approved' &&
          exists(/databases/$(database)/documents/doctors/$(doctorId)) &&
          get(/databases/$(database)/documents/doctors/$(doctorId)).data.status == 'approved' &&
          ('ownerId' in get(/databases/$(database)/documents/doctors/$(doctorId)).data) &&
          isActivePartnerOwnerAccount(get(/databases/$(database)/documents/doctors/$(doctorId)).data.ownerId, 'doctor', doctorId)
        )
      );
      allow list: if existing().status == 'approved' || isAdmin();
      allow create, update: if isValidId(doctorId) &&
        isAdmin() &&
        isValidPublicDoctorCard(incoming()) &&
        incoming().id == doctorId &&
        isAfterDoctorApprovedWithActiveOwner(doctorId, incoming().status);
      allow delete: if isAdmin();
    }

    // =========================================================================
    // EMERGENCY DOCTOR REQUESTS (HIGH-SENSITIVITY PATIENT MEDICAL PRIVACY;
    // Unassigned & public doctors cannot read or claim; requires BACKEND REQUIRED)
    // =========================================================================
    match /emergencyDoctorRequests/{requestId} {
      allow get: if isValidId(requestId) &&
        isSignedIn() &&
        (
          isAdmin() ||
          ('patientUserId' in existing() && existing().patientUserId == request.auth.uid) ||
          ('customerId' in existing() && existing().customerId == request.auth.uid) ||
          ('assignedDoctorId' in existing() && isApprovedDoctorOwner(existing().assignedDoctorId))
        );
      allow list: if isAdmin() ||
        (
          isSignedIn() &&
          (
            ('patientUserId' in existing() && existing().patientUserId == request.auth.uid) ||
            ('customerId' in existing() && existing().customerId == request.auth.uid) ||
            ('assignedDoctorId' in existing() && isApprovedDoctorOwner(existing().assignedDoctorId))
          )
        );
      allow create: if isValidId(requestId) &&
        isSignedIn() &&
        isValidEmergencyRequestData(incoming()) &&
        incoming().patientUserId == request.auth.uid &&
        (!('customerId' in incoming()) || incoming().customerId == request.auth.uid) &&
        incoming().status in ['searching', 'pending'] &&
        !('assignedDoctorId' in incoming()) &&
        !('doctorId' in incoming()) &&
        !('assignedDoctorName' in incoming()) &&
        !('assignedDoctorPhone' in incoming());
      allow update: if isValidId(requestId) &&
        isSignedIn() &&
        isValidEmergencyRequestData(incoming()) &&
        (
          isAdmin() ||
          (
            existing().patientUserId == request.auth.uid &&
            incoming().patientUserId == existing().patientUserId &&
            !(existing().status in ['completed', 'cancelled']) &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'updatedAt'])
          ) ||
          (
            ('assignedDoctorId' in existing()) &&
            isApprovedDoctorOwner(existing().assignedDoctorId) &&
            incoming().patientUserId == existing().patientUserId &&
            ('assignedDoctorId' in incoming()) &&
            incoming().assignedDoctorId == existing().assignedDoctorId &&
            !(existing().status in ['completed', 'cancelled']) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'estimatedArrivalMinutes', 'etaMinutes', 'doctorNotes', 'notes', 'updatedAt'
            ]) &&
            (
              (existing().status == 'accepted' && incoming().status in ['accepted', 'doctor_on_the_way', 'on_the_way', 'completed']) ||
              (existing().status in ['doctor_on_the_way', 'on_the_way'] && incoming().status in ['doctor_on_the_way', 'on_the_way', 'completed'])
            )
          )
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // NON-PII RIDE DISPATCH PROJECTION & ATOMIC BIDDING WORKSPACE
    // (No customerName, customerPhone, driverPhone, or street landmarks)
    // =========================================================================
    match /rideDispatch/{dispatchId} {
      allow get, list: if isAdmin() ||
        (
          isSignedIn() &&
          (
            ('customerId' in existing() && existing().customerId == request.auth.uid) ||
            (
              isActiveApprovedDriver() &&
              existing().vehicleType == callerDriverVehicleType() &&
              (
                (('eligibleDriverIds' in existing()) && callerDriverId() in existing().eligibleDriverIds) ||
                (('confirmedDriverId' in existing()) && existing().confirmedDriverId == callerDriverId())
              )
            )
          )
        );
      allow create: if isValidId(dispatchId) &&
        isSignedIn() &&
        isValidRideDispatchData(incoming()) &&
        incoming().id == dispatchId &&
        incoming().rideId == dispatchId &&
        (
          isAdmin() ||
          (
            incoming().customerId == request.auth.uid &&
            incoming().status in ['REQUESTED', 'OFFER_SENT'] &&
            !('confirmedDriverId' in incoming()) &&
            !('assignedDriverId' in incoming()) &&
            !('agreedFare' in incoming()) &&
            existsAfter(/databases/$(database)/documents/rideBookings/$(dispatchId)) &&
            getAfter(/databases/$(database)/documents/rideBookings/$(dispatchId)).data.customerId == request.auth.uid
          )
        );
      allow update: if isValidId(dispatchId) &&
        isSignedIn() &&
        isRideDispatchInvariantMatch() &&
        (
          isAdmin() ||
          (
            !(existing().status in ['COMPLETED', 'CANCELLED', 'REJECTED', 'EXPIRED', 'completed', 'cancelled']) &&
            (
              (
                ('confirmedDriverId' in existing()) &&
                !(incoming().status in ['EXPIRED', 'COUNTER_OFFERED', 'CONFIRMED', 'REJECTED'])
              ) ||
              (
                !('confirmedDriverId' in existing()) &&
                (incoming().status != 'CONFIRMED' || !('assignedDriverId' in existing())) &&
                (
                  !(incoming().status in ['EXPIRED', 'COUNTER_OFFERED', 'CONFIRMED']) ||
                  (incoming().status == 'EXPIRED' && ('expiresAtMs' in existing()) && request.time.toMillis() > existing().expiresAtMs) ||
                  (incoming().status in ['COUNTER_OFFERED', 'CONFIRMED'] && (!('expiresAtMs' in existing()) || request.time.toMillis() <= existing().expiresAtMs))
                )
              )
            ) &&
            canNonAdminUpdateRideDispatch(incoming().diff(existing()).affectedKeys())
          )
        );
      allow delete: if isAdmin();
    }

    match /deliveryDispatch/{dispatchId} {
      allow read, delete: if isAdmin();
      allow create, update: if isValidId(dispatchId) && isAdmin() && isValidDeliveryDispatchData(incoming());
    }

    match /emergencyDispatch/{dispatchId} {
      allow read, delete: if isAdmin();
      allow create, update: if isValidId(dispatchId) && isAdmin() && isValidEmergencyDispatchData(incoming());
    }

    // =========================================================================
    // UNIVERSAL LOCALITY ROUTING CONFIG & ALERTS
    // =========================================================================
    match /routingConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow create, update: if isValidId(configId) && isAdmin() && isValidRoutingConfigData(incoming());
      allow delete: if isAdmin();
    }

    match /routingAlerts/{alertId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isValidId(alertId) &&
        isSignedIn() &&
        isValidRoutingAlertData(incoming()) &&
        incoming().id == alertId &&
        incoming().status == 'open' &&
        (isAdmin() || isOwnerOfUnavailableRoutingRequest(incoming()));
    }

    // =========================================================================
    // ADMIN ACTIVITY LOGS & ADMINS REGISTRY (APPEND-ONLY VERIFIED ADMIN AUDIT LOGS)
    // =========================================================================
    match /adminActivity/{activityId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(activityId) &&
        isAdmin() &&
        isValidAdminActivityData(incoming()) &&
        incoming().id == activityId;
      allow update, delete: if false;
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // PUSH NOTIFICATION TOKENS & RIDE DELIVERY LOGS
    // =========================================================================
    match /notificationTokens/{tokenId} {
      allow get, list: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      allow create, update: if isValidId(tokenId) &&
        isSignedIn() &&
        incoming().uid == request.auth.uid &&
        isValidNotificationTokenData(incoming());
      allow delete: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
    }

    match /rideNotificationLogs/{logId} {
      allow get, list: if isAdmin() || (isSignedIn() && ('recipientId' in existing()) && existing().recipientId == request.auth.uid);
      allow create, update: if isValidId(logId) &&
        isSignedIn() &&
        isValidRideNotificationLogData(incoming()) &&
        (
          isAdmin() ||
          isActiveApprovedDriver() ||
          (
            exists(/databases/$(database)/documents/rideBookings/$(incoming().rideId)) &&
            get(/databases/$(database)/documents/rideBookings/$(incoming().rideId)).data.customerId == request.auth.uid
          )
        );
      allow delete: if isAdmin();
    }
  }
}
